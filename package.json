{
  "name": "create-stateless-mcp",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "description": "Express-based TypeScript starter for stateless MCP servers with explicit application state handles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waream2/stateless-mcp-starter.git"
  },
  "bugs": {
    "url": "https://github.com/waream2/stateless-mcp-starter/issues"
  },
  "homepage": "https://github.com/waream2/stateless-mcp-starter#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "express",
    "typescript",
    "stateless",
    "dynamodb",
    "postgres"
  ],
  "bin": {
    "create-stateless-mcp": "./bin/create-stateless-mcp.js"
  },
  "files": [
    "bin",
    "template",
    "src",
    "test",
    "docs",
    "README.md",
    "RELEASE_CHECKLIST.md",
    "LICENSE",
    "Dockerfile",
    ".dockerignore",
    ".env.example",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1065.0",
    "@aws-sdk/util-dynamodb": "^3.996.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.19.2",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
